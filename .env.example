# Agnes API keys are saved in the StoryLoop dashboard and encrypted in Turso.
# Keep this encryption secret stable. ENCRYPTION_KEY or ADMIN_PASSWORD is a fallback.
KEYS_ENCRYPTION_SECRET=
AGNES_API_BASE=https://apihub.agnes-ai.com
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_IMAGE_SIZE=1K
AGNES_VIDEO_SIZE=720P
AGNES_TRANSIENT_MAX=5
AGNES_MAX_ATTEMPTS_PER_SCENE=8

# Public HTTPS URL of the canonical fox reference image.
FOX_REFERENCE_IMAGE_URL=

# Upstash Redis REST / Vercel KV REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional fal.ai motion fallback.
FAL_KEY=
FAL_I2V_MODEL=fal-ai/kling-video/v3/standard/image-to-video

TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
VIDEOS_PER_DAY=2
SCENES_PER_VIDEO=8
OUT_DIR=out
TTS_VOICE=ar-EG-SalmaNeural
TTS_RATE=-5%
